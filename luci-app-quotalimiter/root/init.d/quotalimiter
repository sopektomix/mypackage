#!/bin/sh /etc/rc.common
# Copyright (C) 2024-2025 sopeksemprit <www.sopeksemprit.xyz>

START=99
STOP=10
USE_PROCD=1

EXTRA_COMMANDS="status debug"
EXTRA_HELP="        status  Check service status
        debug   Show debug information"

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/quotalimiter.sh daemon
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall quotalimiter.sh 2>/dev/null
    /usr/bin/quotalimiter.sh stop 2>/dev/null
}

status() {
    /usr/bin/quotalimiter.sh status
}

debug() {
    /usr/bin/quotalimiter.sh debug
}
