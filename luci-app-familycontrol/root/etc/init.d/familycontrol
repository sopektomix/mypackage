#!/bin/sh /etc/rc.common
#
# Copyright (C) 2006-2017 OpenWrt.org
# Copyright 2024-2025 sopeksemprit <sopeksemprit.xyz>
#

START=99
USE_PROCD=1

NAME=familycontrol
LOCK="/var/lock/$NAME.lock"
CR=/etc/crontabs/root

start_instance() {
	procd_open_instance
	procd_set_param command /usr/bin/familycontrolctrl
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

_familycontrol_start() {
	# Global master switch
	local global_enabled
	global_enabled="$(uci -q get "$NAME.@$NAME[0].enabled")"

	# At least one enabled device rule?
	local enabled_devices
	enabled_devices="$(grep -c "option enable '1'" /etc/config/$NAME 2>/dev/null)"

	if [ "$global_enabled" = "1" ] && [ "$enabled_devices" -gt 0 ]; then
		touch "$LOCK"
		familycontrol start
		start_instance
		# Daily refresh for safety
		(crontab -l 2>/dev/null; echo "00 1 * * * /etc/init.d/$NAME start") | sort -u | crontab -
	fi
}

start_service() {
	[ -f "$LOCK" ] && exit
	stop_service
	_familycontrol_start
	rm -f "$LOCK"
}

service_triggers() {
	procd_add_reload_trigger 'familycontrol'
}

stop_service() {
	kill -9 $(busybox ps -w | grep 'familycontrolctrl' | grep -v 'grep' | awk '{print $1}') >/dev/null 2>&1
	sed -i '/familycontrol/d' "$CR" >/dev/null 2>&1
	rm -f "$LOCK" 2>/dev/null
	familycontrol stop
}
